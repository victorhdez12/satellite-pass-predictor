# Copy to .env and fill in your own values. Never commit .env.
# Space-Track.org account (free registration at https://www.space-track.org)
SPACETRACK_USERNAME=your-email@example.com
SPACETRACK_PASSWORD=your-space-track-password

# Local PostGIS password, used by docker-compose for both the db and the API
POSTGRES_PASSWORD=change-me

# Only needed when running the backend outside Docker
DATABASE_URL=postgresql://oei:change-me@localhost:5432/oei
